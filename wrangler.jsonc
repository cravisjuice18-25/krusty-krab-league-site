{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krusty-krab-league-site",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.mjs"
}
